{
  "name": "@adobe/commerce-checkout-starter-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "code:check": "npx biome check .",
    "code:fix": "npx biome check --write .",
    "prepare": "husky",
    "test": "vitest run --coverage"
  },
  "lint-staged": {
    "apps/payment-method/**": [
      "npm --prefix apps/payment-method run code:fix"
    ],
    "apps/shipping-method/**": [
      "npm --prefix apps/shipping-method run code:fix"
    ],
    "apps/tax-integration/**": [
      "npm --prefix apps/tax-integration run code:fix"
    ],
    "apps/totals-collector/**": [
      "npm --prefix apps/totals-collector run code:fix"
    ],
    "*": [
      "npm run code:fix"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@vitest/coverage-v8": "^4.0.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "ultracite": "^7.0.0",
    "vitest": "^4.0.7"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
